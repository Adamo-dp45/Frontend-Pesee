{% extends 'base.html.twig' %}

{% block title %}Pesée {{ pesee.numticket ?? pesee.codepesee }}{% endblock %}

{% set enCours = pesee.statut == 'EN_COURS' %}
{% set reste = pesee.resteapayer|default((pesee.montantdu|default(0)) - (pesee.montantpaye|default(0))) %}

{% block body %}
    <div class="max-w-4xl">
        <div class="mb-6">
            <a href="{{ path('bilan.index') }}" class="text-sm text-muted-foreground underline-offset-4 hover:underline">
                ← Retour au bilan
            </a>
            <div class="flex flex-wrap items-center gap-3 mt-2">
                <h1 class="text-2xl font-semibold tracking-tight">
                    Pesée {{ pesee.numticket ?? pesee.codepesee }}
                </h1>
                {{ include('partials/_etat.html.twig', { statut: pesee.statutReglement }) }}
                {% if enCours %}
                    <twig:Badge variant="secondary">Camion sur le pont</twig:Badge>
                {% endif %}
            </div>
            <p class="text-sm text-muted-foreground mt-1">
                {{ pesee.site.libellesite ?? '—' }} · {{ pesee.produit.libelle ?? '—' }}
                · {{ pesee.fournisseur.nomComplet ?? 'planteur inconnu' }}
            </p>
        </div>

        {% if enCours %}
            {#
                - Le second passage n'a pas eu lieu : pas de poids net, donc pas de créance et
                  aucun versement possible. La pesée se complétera à la prochaine synchronisation.
            #}
            <twig:Alert class="mb-4">
                <twig:ux:icon name="lucide:truck" class="size-4" />
                <twig:Alert:Title>Cette pesée n'est pas terminée</twig:Alert:Title>
                <twig:Alert:Description>
                    Le camion n'est pas encore ressorti. Tant que le second passage n'est pas
                    enregistré, il n'y a ni poids net, ni montant, ni versement possible.
                </twig:Alert:Description>
            </twig:Alert>
        {% endif %}

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-6">
            {{ include('tableau_de_bord/_kpi.html.twig', {
                titre: 'Poids net', valeur: pesee.poidsnet|default(0), unite: 'kg',
                detail: 'brut ' ~ (pesee.poidsbrut|default(0))|number_format(0, ',', ' ') ~ ' kg', icone: 'lucide:weight'
            }) }}
            {{ include('tableau_de_bord/_kpi.html.twig', {
                titre: 'Montant dû', valeur: pesee.montantdu|default(0), unite: 'F',
                detail: (pesee.prixunitaire|default(0))|number_format(0, ',', ' ') ~ ' F le kilo', icone: 'lucide:banknote'
            }) }}
            {#
                - « Versé » ne compte que les versements confirmés. Ceux qui sont encore en vol
                  ont pourtant déjà quitté la caisse : les taire ferait croire qu'on peut engager
                  la totalité du reste.
            #}
            {{ include('tableau_de_bord/_kpi.html.twig', {
                titre: 'Déjà versé', valeur: pesee.montantpaye|default(0), unite: 'F',
                detail: enVol > 0
                    ? enVol|number_format(0, ',', ' ') ~ ' F en cours de confirmation'
                    : paiements|length ~ ' versement(s)',
                icone: 'lucide:hand-coins'
            }) }}
            {{ include('tableau_de_bord/_kpi.html.twig', {
                titre: 'Reste à payer', valeur: reste, unite: 'F',
                detail: enVol > 0
                    ? 'dont ' ~ enVol|number_format(0, ',', ' ') ~ ' F déjà engagés'
                    : (reste > 0 ? 'créance ouverte' : 'pesée soldée'),
                icone: 'lucide:receipt-text'
            }) }}
        </div>

        {% if payable and not enCours and reste > 0 %}
            <div class="mb-6">
                <twig:Button as="a" href="{{ path('paiement.new', { operation: pesee.id }) }}">
                    <twig:ux:icon name="lucide:send" class="size-4" />
                    Verser au planteur
                </twig:Button>
            </div>
        {% endif %}

        <div class="grid gap-4 lg:grid-cols-2 mb-6">
            <twig:Card>
                <twig:Card:Header>
                    <twig:Card:Title>Les deux passages</twig:Card:Title>
                </twig:Card:Header>
                <twig:Card:Content class="grid gap-3 sm:grid-cols-2">
                    {{ include('partials/_donnee.html.twig', { libelle: 'Poids 1', valeur: pesee.poids1 ? pesee.poids1|number_format(0, ',', ' ') ~ ' kg' : null }) }}
                    {{ include('partials/_donnee.html.twig', { libelle: 'Poids 2', valeur: pesee.poids2 ? pesee.poids2|number_format(0, ',', ' ') ~ ' kg' : null }) }}
                    {{ include('partials/_donnee.html.twig', { libelle: 'Entrée', valeur: pesee.peseeAt1 ? pesee.peseeAt1|date('d/m/Y à H:i') : null }) }}
                    {{ include('partials/_donnee.html.twig', { libelle: 'Sortie', valeur: pesee.peseeAt2 ? pesee.peseeAt2|date('d/m/Y à H:i') : null }) }}
                    {{ include('partials/_donnee.html.twig', { libelle: 'Peseur', valeur: pesee.peseur }) }}
                    {{ include('partials/_donnee.html.twig', { libelle: 'Reçue du poste le', valeur: pesee.syncAt ? pesee.syncAt|date('d/m/Y à H:i') : null }) }}
                </twig:Card:Content>
            </twig:Card>

            <twig:Card>
                <twig:Card:Header>
                    <twig:Card:Title>Transport</twig:Card:Title>
                </twig:Card:Header>
                <twig:Card:Content class="grid gap-3 sm:grid-cols-2">
                    {{ include('partials/_donnee.html.twig', { libelle: 'Opération', valeur: pesee.mouvement }) }}
                    {{ include('partials/_donnee.html.twig', { libelle: 'Véhicule', valeur: pesee.immatriculation }) }}
                    {{ include('partials/_donnee.html.twig', { libelle: 'Remorque', valeur: pesee.remorque }) }}
                    {{ include('partials/_donnee.html.twig', { libelle: 'Chauffeur', valeur: pesee.chauffeur }) }}
                    {{ include('partials/_donnee.html.twig', { libelle: 'Transporteur', valeur: pesee.transporteur }) }}
                    {{ include('partials/_donnee.html.twig', { libelle: 'Client', valeur: pesee.client }) }}
                    {{ include('partials/_donnee.html.twig', { libelle: 'Provenance', valeur: pesee.provenance }) }}
                    {{ include('partials/_donnee.html.twig', { libelle: 'Destination', valeur: pesee.destination }) }}
                    {{ include('partials/_donnee.html.twig', { libelle: 'Contact PL', valeur: pesee.contactPl }) }}
                    {{ include('partials/_donnee.html.twig', { libelle: 'Conteneur', valeur: pesee.conteneur }) }}
                    {{ include('partials/_donnee.html.twig', { libelle: 'Plomb', valeur: pesee.plomb }) }}
                    {{ include('partials/_donnee.html.twig', { libelle: 'Réf. poste', valeur: pesee.refDesktop }) }}
                </twig:Card:Content>
            </twig:Card>
        </div>

        <twig:Card>
            <twig:Card:Header>
                <twig:Card:Title>Versements</twig:Card:Title>
                <twig:Card:Description>
                    Une pesée se règle en plusieurs fois. Un versement « envoyé » a déjà quitté la
                    caisse du poste sans être confirmé par la passerelle.
                </twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content class="p-0">
                <div class="overflow-x-auto">
                    <twig:Table>
                        <twig:Table:Header>
                            <twig:Table:Row>
                                <twig:Table:Head>Date</twig:Table:Head>
                                <twig:Table:Head>Référence</twig:Table:Head>
                                <twig:Table:Head>Destinataire</twig:Table:Head>
                                <twig:Table:Head class="text-right">Montant</twig:Table:Head>
                                <twig:Table:Head>Statut</twig:Table:Head>
                            </twig:Table:Row>
                        </twig:Table:Header>
                        <twig:Table:Body>
                            {% for versement in paiements %}
                                <twig:Table:Row>
                                    <twig:Table:Cell class="whitespace-nowrap">{{ versement.createdAt|date('d/m/Y H:i') }}</twig:Table:Cell>
                                    <twig:Table:Cell class="font-mono text-xs">{{ versement.reference }}</twig:Table:Cell>
                                    <twig:Table:Cell>
                                        {{ versement.numeroDestinataire ?? '—' }}
                                        {{ versement.reseau ? ' · ' ~ versement.reseau }}
                                    </twig:Table:Cell>
                                    <twig:Table:Cell class="text-right tabular-nums">{{ versement.montant|number_format(0, ',', ' ') }} F</twig:Table:Cell>
                                    <twig:Table:Cell>
                                        {{ include('partials/_etat.html.twig', { statut: versement.statut }) }}
                                        {% if versement.messageErreur %}
                                            <div class="text-xs text-destructive mt-1">{{ versement.messageErreur }}</div>
                                        {% endif %}
                                    </twig:Table:Cell>
                                </twig:Table:Row>
                            {% else %}
                                <twig:Table:Row>
                                    <twig:Table:Cell colspan="5" class="text-center text-muted-foreground py-8">
                                        Aucun versement sur cette pesée
                                    </twig:Table:Cell>
                                </twig:Table:Row>
                            {% endfor %}
                        </twig:Table:Body>
                    </twig:Table>
                </div>
            </twig:Card:Content>
        </twig:Card>
    </div>
{% endblock %}
