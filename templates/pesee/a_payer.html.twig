{% extends 'base.html.twig' %}

{% block title %}À payer{% endblock %}

{% block body %}
    <div class="mb-6">
        <h1 class="text-2xl font-semibold tracking-tight">À payer</h1>
        <p class="mt-1 text-sm text-muted-foreground">
            Les pesées terminées qui attendent encore un versement.
        </p>
    </div>

    {#
        - Écran d'action, pas d'analyse : la liste est bornée d'avance aux pesées terminées et non
          soldées. Pour tout le reste — historique, exports, filtres croisés — c'est le bilan.
        - 'multiSite' : l'opérateur ne tient qu'un poste, lui montrer une colonne et un filtre qui
          répètent la même valeur ne l'aide pas.
    #}
    <div {{ react_component('Caisse/TableAPayer', {
        items: items,
        meta: meta,
        queryParams: queryParams,
        sortMeta: sortMeta,
        sites: sites,
        multiSite: not app.user.estOperateur,
    }) }}></div>
{% endblock %}
