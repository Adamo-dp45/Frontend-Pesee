{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% set totaux = stats.totaux|default({}) %}
{% set soldes = stats.soldes|default({}) %}

{% block body %}
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Tableau de bord</h1>
            <p class="text-sm text-muted-foreground mt-1">
                {{ app.user.nomEntreprise ?? 'Votre entreprise' }} — {{ periode.libelle }}
            </p>
        </div>

        {# Le filtre de période vit dans l'URL : un tableau de bord se partage par copier-coller #}
        <form method="get" class="flex flex-wrap items-end gap-2">
            <div>
                <twig:Label for="du" class="text-xs">Du</twig:Label>
                <twig:Input type="date" id="du" name="du" value="{{ periode.du }}" class="h-9" />
            </div>
            <div>
                <twig:Label for="au" class="text-xs">Au</twig:Label>
                <twig:Input type="date" id="au" name="au" value="{{ periode.au }}" class="h-9" />
            </div>
            <twig:Button type="submit" size="sm">Appliquer</twig:Button>
        </form>
    </div>

    {% if stats.postesSilencieux|default([])|length > 0 %}
        {#
            - Un poste muet depuis plusieurs jours est probablement en panne. Sans cette alerte,
              ça ne se remarque qu'en s'étonnant d'un tonnage bas, des semaines plus tard.
        #}
        <twig:Alert variant="destructive" class="mb-6">
            <twig:ux:icon name="lucide:triangle-alert" class="size-4" />
            <twig:Alert:Title>
                {{ stats.postesSilencieux|length }} pont{{ stats.postesSilencieux|length > 1 ? 's' : '' }} bascule à vérifier
            </twig:Alert:Title>
            <twig:Alert:Description>
                {% for poste in stats.postesSilencieux %}
                    <span class="inline-block mr-3">
                        <strong>{{ poste.site }}</strong> —
                        {% if poste.dernierEnvoi %}
                            plus rien reçu depuis {{ poste.joursSansEnvoi }} jour(s)
                        {% else %}
                            déclaré il y a {{ poste.joursDepuisCreation }} jour(s), jamais mis en service
                        {% endif %}
                    </span>
                {% endfor %}
            </twig:Alert:Description>
        </twig:Alert>
    {% endif %}

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-6">
        {{ include('tableau_de_bord/_kpi.html.twig', {
            titre: 'Tonnage net', valeur: (totaux.tonnageNet|default(0)) / 1000, unite: 't',
            detail: (totaux.nbPesees|default(0)) ~ ' pesée(s) terminée(s)', icone: 'lucide:weight'
        }) }}
        {{ include('tableau_de_bord/_kpi.html.twig', {
            titre: 'Montant dû aux planteurs', valeur: totaux.montantDu|default(0), unite: 'F',
            detail: (totaux.montantPaye|default(0))|number_format(0, ',', ' ') ~ ' F déjà versés', icone: 'lucide:banknote'
        }) }}
        {{ include('tableau_de_bord/_kpi.html.twig', {
            titre: 'Reste à payer', valeur: totaux.montantRestant|default(0), unite: 'F',
            detail: 'sur la période affichée', icone: 'lucide:hand-coins'
        }) }}
        {#
            - L'opérateur ne voit que la caisse de ses ponts bascules : l'API ne lui envoie même pas
              le solde de l'entreprise. Afficher « Trésorerie » avec un total amputé mentirait.
        #}
        {% if soldes.entreprise is null %}
            {{ include('tableau_de_bord/_kpi.html.twig', {
                titre: 'Ma caisse', valeur: soldes.sites|default(0), unite: 'F',
                detail: 'de quoi payer les planteurs', icone: 'lucide:wallet'
            }) }}
        {% else %}
            {{ include('tableau_de_bord/_kpi.html.twig', {
                titre: 'Trésorerie', valeur: soldes.entreprise + (soldes.sites|default(0)), unite: 'F',
                detail: (soldes.sites|default(0))|number_format(0, ',', ' ') ~ ' F dans les caisses', icone: 'lucide:wallet'
            }) }}
        {% endif %}
    </div>

    {% if totaux.nbEnCours|default(0) > 0 %}
        <twig:Alert class="mb-6">
            <twig:ux:icon name="lucide:truck" class="size-4" />
            <twig:Alert:Description>
                {{ totaux.nbEnCours }} camion(s) actuellement sur un pont bascule, en attente du second passage.
                Ces pesées n'ont pas encore de poids net et ne comptent pas dans les totaux.
            </twig:Alert:Description>
        </twig:Alert>
    {% endif %}

    <div class="grid gap-4 lg:grid-cols-3 mb-6">
        <twig:Card class="lg:col-span-2">
            <twig:Card:Header>
                <twig:Card:Title>Tonnage par jour</twig:Card:Title>
                <twig:Card:Description>Évolution du poids net pesé sur la période</twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content>
                {% if stats.parJour|default([])|length > 0 %}
                    <canvas id="chartParJour" height="110"
                            data-labels="{{ stats.parJour|map(l => l.jour)|json_encode }}"
                            data-valeurs="{{ stats.parJour|map(l => l.tonnageNet)|json_encode }}"></canvas>
                {% else %}
                    {{ include('partials/empty_chart.html.twig') }}
                {% endif %}
            </twig:Card:Content>
        </twig:Card>

        <twig:Card>
            <twig:Card:Header>
                <twig:Card:Title>Par produit</twig:Card:Title>
                <twig:Card:Description>Répartition du tonnage</twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content>
                {% if stats.parProduit|default([])|length > 0 %}
                    <canvas id="chartParProduit" height="200"
                            data-labels="{{ stats.parProduit|map(l => l.produit)|json_encode }}"
                            data-valeurs="{{ stats.parProduit|map(l => l.tonnageNet)|json_encode }}"></canvas>
                {% else %}
                    {{ include('partials/empty_chart.html.twig') }}
                {% endif %}
            </twig:Card:Content>
        </twig:Card>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
        <twig:Card>
            <twig:Card:Header>
                <twig:Card:Title>Ponts bascules</twig:Card:Title>
                <twig:Card:Description>Production et caisse de chaque site</twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content class="p-0">
                <div class="overflow-x-auto">
                    <twig:Table>
                        <twig:Table:Header>
                            <twig:Table:Row>
                                <twig:Table:Head>Site</twig:Table:Head>
                                <twig:Table:Head class="text-right">Pesées</twig:Table:Head>
                                <twig:Table:Head class="text-right">Tonnage</twig:Table:Head>
                                <twig:Table:Head class="text-right">Caisse</twig:Table:Head>
                            </twig:Table:Row>
                        </twig:Table:Header>
                        <twig:Table:Body>
                            {% for site in stats.parSite|default([]) %}
                                <twig:Table:Row>
                                    <twig:Table:Cell class="font-medium">{{ site.site }}</twig:Table:Cell>
                                    <twig:Table:Cell class="text-right">{{ site.nbPesees }}</twig:Table:Cell>
                                    <twig:Table:Cell class="text-right">{{ (site.tonnageNet / 1000)|number_format(1, ',', ' ') }} t</twig:Table:Cell>
                                    <twig:Table:Cell class="text-right tabular-nums">{{ site.solde|number_format(0, ',', ' ') }} F</twig:Table:Cell>
                                </twig:Table:Row>
                            {% else %}
                                <twig:Table:Row>
                                    <twig:Table:Cell colspan="4" class="text-center text-muted-foreground py-8">
                                        Aucun pont bascule dans votre périmètre
                                    </twig:Table:Cell>
                                </twig:Table:Row>
                            {% endfor %}
                        </twig:Table:Body>
                    </twig:Table>
                </div>
            </twig:Card:Content>
        </twig:Card>

        <twig:Card>
            <twig:Card:Header>
                <twig:Card:Title>Dernières pesées</twig:Card:Title>
                <twig:Card:Description>Les plus récentes reçues des postes</twig:Card:Description>
                <twig:Card:Action>
                    <twig:Button as="a" href="{{ path('bilan.index') }}" variant="outline" size="sm">Voir le bilan</twig:Button>
                </twig:Card:Action>
            </twig:Card:Header>
            <twig:Card:Content class="p-0">
                <div class="overflow-x-auto">
                    <twig:Table>
                        <twig:Table:Header>
                            <twig:Table:Row>
                                <twig:Table:Head>Ticket</twig:Table:Head>
                                <twig:Table:Head>Planteur</twig:Table:Head>
                                <twig:Table:Head>Produit</twig:Table:Head>
                                <twig:Table:Head class="text-right">Net</twig:Table:Head>
                                <twig:Table:Head>Règlement</twig:Table:Head>
                            </twig:Table:Row>
                        </twig:Table:Header>
                        <twig:Table:Body>
                            {% for pesee in stats.dernieresPesees|default([]) %}
                                <twig:Table:Row>
                                    <twig:Table:Cell class="font-medium">{{ pesee.numticket ?? '—' }}</twig:Table:Cell>
                                    <twig:Table:Cell>{{ pesee.planteur ?? '—' }}</twig:Table:Cell>
                                    <twig:Table:Cell>{{ pesee.produit ?? '—' }}</twig:Table:Cell>
                                    <twig:Table:Cell class="text-right tabular-nums">{{ pesee.poidsnet|number_format(0, ',', ' ') }} kg</twig:Table:Cell>
                                    <twig:Table:Cell>{{ include('partials/_statut_reglement.html.twig', { statut: pesee.statutReglement }) }}</twig:Table:Cell>
                                </twig:Table:Row>
                            {% else %}
                                <twig:Table:Row>
                                    <twig:Table:Cell colspan="5" class="text-center text-muted-foreground py-8">
                                        Aucune pesée reçue pour le moment
                                    </twig:Table:Cell>
                                </twig:Table:Row>
                            {% endfor %}
                        </twig:Table:Body>
                    </twig:Table>
                </div>
            </twig:Card:Content>
        </twig:Card>
    </div>
{% endblock %}
