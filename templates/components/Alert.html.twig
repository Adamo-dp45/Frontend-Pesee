{# @prop variant 'default'|'destructive'|'success'|'warning'|'info' The visual style variant. #}
{# @block content The alert content, typically includes `Alert:Title` and `Alert:Description`. #}

{#
    - Les quatre teintes du domaine vivent ICI, et nulle part ailleurs. Elles étaient auparavant
      recopiées en chaînes de classes dans 'partials/flash.html.twig', dans la page de connexion et
      dans celle du mot de passe oublié : la même notion — « ça a marché », « attention » — n'avait
      donc pas la même apparence selon l'écran, et 'variant="warning"' passé au composant ne
      produisait tout simplement rien puisque la variante n'existait pas.

    - 'default' reste neutre : c'est une note sans coloration particulière. Une information se
      demande explicitement par 'variant="info"', sinon on ne saurait plus distinguer les deux.
#}
{%- props variant = 'default' -%}
{%- set style = html_cva(
    base: "group/alert relative grid w-full gap-0.5 rounded-lg border px-2.5 py-2 text-left rtl:text-start text-sm has-data-[slot=alert-action]:relative ltr:has-data-[slot=alert-action]:pr-18 rtl:has-data-[slot=alert-action]:pe-18 has-[>svg]:grid-cols-[auto_1fr] has-[>svg]:gap-x-2 *:[svg]:row-span-2 *:[svg]:translate-y-0.5 *:[svg]:text-current *:[svg:not([class*='size-'])]:size-4",
    variants: {
        variant: {
            default: 'bg-card text-card-foreground',
            destructive: 'border-destructive/30 bg-destructive/10 text-destructive *:data-[slot=alert-description]:text-destructive/90 *:[svg]:text-current',
            success: 'border-emerald-200 bg-emerald-50 text-emerald-900 dark:border-emerald-900 dark:bg-emerald-950 dark:text-emerald-50',
            warning: 'border-amber-200 bg-amber-50 text-amber-900 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-50',
            info: 'border-sky-200 bg-sky-50 text-sky-900 dark:border-sky-900 dark:bg-sky-950 dark:text-sky-50',
        },
    },
) -%}

<div
    data-slot="alert"
    role="alert"
    class="{{ style.apply({variant: variant}, attributes.render('class'))|tailwind_merge }}"
    {{ attributes }}
>
    {%- block content %}{% endblock -%}
</div>
