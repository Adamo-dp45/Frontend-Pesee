{% extends 'base.html.twig' %}

{% block title %}Verser à un planteur{% endblock %}

{% set reste = pesee.resteaengager|default((pesee.montantdu|default(0)) - (pesee.montantpaye|default(0))) %}

{#
    - Ce dont le poste dispose RÉELLEMENT, CAISSE PAR CAISSE. Les espèces sont disponibles telles
      quelles ; le flotte, lui, se lit net des versements déjà partis sans réponse de la passerelle.
      C'est l'un de ces deux montants que l'API confrontera à la saisie, selon le mode choisi.
#}
{% set dispoEspeces = caisse ? caisse.soldePhysique|default(0) : null %}
{% set dispoFlotte = caisse ? (caisse.soldeNumerique|default(0)) - caisse.immobilise : null %}

{% block body %}
    <div class="max-w-xl">
        <div class="mb-6">
            <a href="{{ path('bilan.index') }}" class="text-sm text-muted-foreground underline-offset-4 hover:underline">
                ← Retour au bilan
            </a>
            <h1 class="text-2xl font-semibold tracking-tight mt-2">Verser à un planteur</h1>
            <p class="text-sm text-muted-foreground mt-1">
                Pesée {{ pesee.numticket ?? '—' }} · {{ pesee.fournisseur.nomComplet ?? 'planteur inconnu' }}
            </p>
        </div>

        {# Les erreurs du formulaire sont rendues par 'form_errors' dans sa carte, plus ici #}

{#
            - Le motif du planteur ferme le MOBILE MONEY, pas le versement : les espèces restent
              ouvertes, et c'est précisément le planteur sans téléphone qu'on règle en liquide. Le
              bandeau le dit donc en avertissement, pas en refus.
        #}
        {% if pesee.fournisseur.motifNonPayable|default(null) %}
            <twig:Alert variant="warning" class="mb-4">
                <twig:ux:icon name="lucide:triangle-alert" class="size-4" />
                <twig:Alert:Title>Mobile money impossible pour ce planteur</twig:Alert:Title>
                <twig:Alert:Description>
                    {{ pesee.fournisseur.motifNonPayable }} Vous pouvez le régler en espèces, ou
                    <a href="{{ path('fournisseur.edit', { id: pesee.fournisseur.id }) }}" class="underline">
                        compléter sa fiche
                    </a>.
                </twig:Alert:Description>
            </twig:Alert>
        {% endif %}

        <twig:Card class="mb-4">
            <twig:Card:Content class="pt-6 grid gap-3 sm:grid-cols-3">
                <div>
                    <p class="text-xs text-muted-foreground">Poids net</p>
                    <p class="text-lg font-semibold tabular-nums">{{ (pesee.poidsnet|default(0))|number_format(0, ',', ' ') }} kg</p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Montant dû</p>
                    <p class="text-lg font-semibold tabular-nums">{{ (pesee.montantdu|default(0))|number_format(0, ',', ' ') }} F</p>
                    {# Ce qui part sur l'épargne ne passera pas par le guichet : le dire ici évite d'expliquer l'écart au planteur sans y avoir pensé #}
                    {% if (pesee.retenue|default(0)) > 0 %}
                        <p class="text-xs text-muted-foreground">dont {{ pesee.retenue|number_format(0, ',', ' ') }} F mis en compte</p>
                    {% endif %}
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Reste à payer</p>
                    <p class="text-lg font-semibold tabular-nums">{{ reste|number_format(0, ',', ' ') }} F</p>
                </div>
            </twig:Card:Content>
        </twig:Card>

        {#
            - La caisse du poste, en face du montant à verser : c'est la question qu'on se pose la
              main sur le clavier. Sans elle, l'opérateur saisit, valide, et n'apprend qu'alors que
              le poste n'a pas de quoi payer — avec le planteur en face de lui.
        #}
        {% if caisse %}
            <twig:Card class="mb-4">
                <twig:Card:Header>
                    <twig:Card:Title>Caisse de {{ caisse.site }}</twig:Card:Title>
                    <twig:Card:Description>
                        C'est de l'une de ces deux caisses que part le versement, selon le mode choisi.
                    </twig:Card:Description>
                </twig:Card:Header>
                <twig:Card:Content class="grid gap-3 sm:grid-cols-3">
                    <div>
                        <p class="text-xs text-muted-foreground">Espèces disponibles</p>
                        <p class="text-lg font-semibold tabular-nums {{ dispoEspeces < reste ? 'text-destructive' }}">
                            {{ dispoEspeces|number_format(0, ',', ' ') }} F
                        </p>
                    </div>
                    <div>
                        <p class="text-xs text-muted-foreground">Flotte engagé</p>
                        {# Des versements partis chez l'agrégateur, pas encore confirmés : l'argent a quitté la caisse. Les espèces, elles, ne restent jamais en vol #}
                        <p class="text-lg font-semibold tabular-nums {{ caisse.immobilise > 0 ? 'text-amber-600 dark:text-amber-400' }}">
                            {{ caisse.immobilise > 0 ? '− ' ~ caisse.immobilise|number_format(0, ',', ' ') ~ ' F' : '—' }}
                        </p>
                    </div>
                    <div>
                        <p class="text-xs text-muted-foreground">Flotte disponible</p>
                        <p class="text-lg font-semibold tabular-nums {{ dispoFlotte < reste ? 'text-destructive' }}">
                            {{ dispoFlotte|number_format(0, ',', ' ') }} F
                        </p>
                    </div>
                </twig:Card:Content>
            </twig:Card>

            {#
                - Prévenir vaut mieux que laisser l'API refuser : le message est le même, mais il
                  arrive avant la saisie plutôt qu'après. La demande de solde est le geste attendu.
            #}
            {% if dispoEspeces < reste and dispoFlotte < reste %}
                <twig:Alert variant="warning" class="mb-4">
                    <twig:ux:icon name="lucide:triangle-alert" class="size-4" />
                    <twig:Alert:Title>Aucune des deux caisses ne couvre le reste à payer</twig:Alert:Title>
                    <twig:Alert:Description>
                        {{ dispoEspeces|number_format(0, ',', ' ') }} F en espèces et
                        {{ dispoFlotte|number_format(0, ',', ' ') }} F de flotte disponibles pour
                        {{ reste|number_format(0, ',', ' ') }} F dus. Vous pouvez verser une partie
                        maintenant — une pesée se règle en plusieurs fois — ou
                        {% if is_granted('DEMANDESOLDE_CREER') %}
                            <a href="{{ path('demande.new') }}" class="underline">demander du solde</a>.
                        {% else %}
                            faire doter le poste par un administrateur.
                        {% endif %}
                    </twig:Alert:Description>
                </twig:Alert>
            {% endif %}
        {% endif %}

        {#
            - « Reste à payer » ne compte que les versements confirmés. L'API, elle, décompte aussi
              ceux qui sont en vol : elle refusera un montant trop élevé même s'il semble tenir ici.
              C'est voulu — on ne peut pas engager deux fois la même somme.
        #}
        <twig:Card>
            <twig:Card:Header>
                <twig:Card:Title>Versement au planteur</twig:Card:Title>
                <twig:Card:Description>
                    Une pesée peut être réglée en plusieurs fois. En espèces, le versement est acquis
                    dès la saisie ; en mobile money, l'argent sort de la caisse dès l'envoi et y
                    revient si la passerelle échoue.
                </twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content>
                {#
                    - 'modules/mode_reglement.js' ne fait que masquer les deux champs mobiles quand
                      on choisit les espèces. Sans JavaScript la page reste utilisable : les champs
                      s'affichent, et le serveur les ignore pour un règlement en liquide.
                #}
                {{ form_start(form) }}
                    {{ form_errors(form) }}
                    <div class="grid gap-4">
                        {{ form_row(form.modeReglement) }}
                        {{ form_row(form.montant) }}
                        <div data-si-mobile class="grid gap-4">
                            {{ form_row(form.numeroDestinataire) }}
                            {{ form_row(form.reseau) }}
                        </div>
                    </div>
                    <div class="mt-6 flex items-center justify-end gap-3 border-t border-border pt-4">
                        <a href="{{ path('bilan.index') }}" class="btn btn-secondary">Annuler</a>
                        <button class="btn btn-primary">Verser</button>
                    </div>
                {{ form_end(form) }}
            </twig:Card:Content>
        </twig:Card>
    </div>
{% endblock %}
