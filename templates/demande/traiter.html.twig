{% extends 'base.html.twig' %}

{% block title %}Traiter la demande{% endblock %}

{% block body %}
    <div class="max-w-xl">
        <div class="mb-6">
            <a href="{{ path('demande.index') }}" class="text-sm text-muted-foreground underline-offset-4 hover:underline">
                ← Retour aux demandes
            </a>
            <h1 class="mt-2 text-2xl font-semibold tracking-tight">Traiter la demande</h1>
            <p class="mt-1 text-sm text-muted-foreground">
                {{ demande.site.libellesite ?? '—' }} · demandée par {{ demande.demandePar.nomComplet ?? '—' }}
                le {{ demande.createdAt|date('d/m/Y à H:i') }}
            </p>
        </div>

        {#
            - Ce sur quoi la décision se prend, avant le formulaire : le montant réclamé, ce que
              l'entreprise a en caisse, et le motif de l'opérateur. Approuver DÉPLACE DE L'ARGENT.
        #}
        <twig:Card class="mb-4">
            <twig:Card:Content class="grid gap-3 pt-6 sm:grid-cols-3">
                <div>
                    <p class="text-xs text-muted-foreground">Montant demandé</p>
                    <p class="text-lg font-semibold tabular-nums">{{ demande.montantDemande|number_format(0, ',', ' ') }} F</p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Caisse du poste</p>
                    <p class="text-lg font-semibold tabular-nums">{{ (demande.site.solde ?? 0)|number_format(0, ',', ' ') }} F</p>
                </div>
                <div>
                    <p class="text-xs text-muted-foreground">Solde de l'entreprise</p>
                    <p class="text-lg font-semibold tabular-nums">{{ entreprise.solde|number_format(0, ',', ' ') }} F</p>
                </div>
                {% if demande.motif %}
                    <div class="sm:col-span-3">
                        <p class="text-xs text-muted-foreground">Motif</p>
                        <p class="mt-1 text-sm">{{ demande.motif }}</p>
                    </div>
                {% endif %}
            </twig:Card:Content>
        </twig:Card>

        {# Une demande déjà traitée : l'API refuse, autant le dire avant la saisie #}
        {% if demande.statut != 'EN_ATTENTE' %}
            <twig:Alert variant="destructive" class="mb-4">
                <twig:ux:icon name="lucide:triangle-alert" class="size-4" />
                <twig:Alert:Description>
                    Cette demande a déjà été traitée ({{ demande.statutLibelle }}) : elle ne peut plus l'être une seconde fois.
                </twig:Alert:Description>
            </twig:Alert>
        {% endif %}

        <twig:Card>
            <twig:Card:Header>
                <twig:Card:Title>Décision</twig:Card:Title>
                <twig:Card:Description>
                    Approuver transfère l'argent du solde de l'entreprise vers la caisse du poste, en
                    deux écritures. Rejeter ne déplace rien, mais doit être motivé.
                </twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content>
                {{ form_start(form) }}
                    {{ form_errors(form) }}
                    <div class="grid gap-4">
                        {{ form_row(form.decision) }}
                        {{ form_row(form.montantAccorde) }}
                        {{ form_row(form.motifRejet) }}
                    </div>
                    <div class="mt-6 flex items-center justify-end gap-3 border-t border-border pt-4">
                        <a href="{{ path('demande.index') }}" class="btn btn-secondary">Annuler</a>
                        <button class="btn btn-primary">Enregistrer la décision</button>
                    </div>
                {{ form_end(form) }}
            </twig:Card:Content>
        </twig:Card>
    </div>
{% endblock %}
