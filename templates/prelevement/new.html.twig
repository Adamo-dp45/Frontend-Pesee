{% extends 'base.html.twig' %}

{% block title %}Nouvelle mise en compte{% endblock %}

{% block body %}
    <div class="mb-6">
        <a href="{{ path('prelevement.index') }}" class="text-sm text-muted-foreground underline-offset-4 hover:underline">
            ← Retour aux mises en compte
        </a>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight">Nouvelle mise en compte</h1>
        <p class="mt-1 text-sm text-muted-foreground">
            Transmettez ce que le planteur vous a demandé. Le prélèvement ne commencera qu'une fois
            la demande approuvée, et seulement sur ses pesées à venir.
        </p>
    </div>

    {% include 'prelevement/_form.html.twig' with { button: 'Envoyer la demande' } %}
{% endblock %}
