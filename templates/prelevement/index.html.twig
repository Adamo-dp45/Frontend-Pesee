{% extends 'base.html.twig' %}

{% block title %}Mises en compte{% endblock %}

{% block body %}
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Mises en compte</h1>
            <p class="text-sm text-muted-foreground mt-1">
                Quand un planteur demande qu'on lui garde une part de chaque pesée, son opérateur
                le signale ici. L'administrateur ouvre le prélèvement, ou le refuse.
            </p>
        </div>
        {# Seul l'opérateur, qui a le planteur devant lui, a une raison d'en déposer #}
        {% if peutDemander %}
            <twig:Button as="a" href="{{ path('prelevement.new') }}" size="sm">
                <twig:ux:icon name="lucide:plus" class="size-4" />
                Demander une mise en compte
            </twig:Button>
        {% endif %}
    </div>

    {#
        - Les filtres vivent DANS la table : ils écrivent dans la même URL que le tri et la
          pagination, donc un écran filtré se partage tel quel.
    #}
    <div {{ react_component('Caisse/TableDemandesPrelevement', {
        items: items,
        meta: meta,
        queryParams: queryParams,
        sortMeta: sortMeta,
        sites: sites,
        jeton: csrf_token('gestion'),
    }) }}></div>
{% endblock %}
