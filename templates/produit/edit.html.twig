{% extends 'base.html.twig' %}

{% block title %}{{ produit.libelle }}{% endblock %}

{% block body %}
    <div class="mb-6">
        <a href="{{ path('produit.index') }}" class="text-sm text-muted-foreground underline-offset-4 hover:underline">
            ← Retour aux produits
        </a>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight">{{ produit.libelle }}</h1>
        <p class="mt-1 text-sm text-muted-foreground">
            {# Le pont bascule n'est pas modifiable : le déplacer détacherait les pesées de leur référentiel local #}
            {{ produit.site.libellesite ?? 'Aucun pont bascule' }}
        </p>
    </div>

    {% include 'produit/_form.html.twig' with { button: 'Enregistrer' } %}
{% endblock %}
