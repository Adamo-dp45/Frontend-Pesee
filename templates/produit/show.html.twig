{% extends 'base.html.twig' %}

{% block title %}{{ produit.libelle }}{% endblock %}

{% block body %}
<div class="mb-6">
    <a href="{{ path('produit.index') }}" class="text-sm text-muted-foreground underline-offset-4 hover:underline">
        ← Retour aux produits
    </a>
    <div class="flex flex-wrap items-center gap-3 mt-2">
        <h1 class="text-2xl font-semibold tracking-tight">{{ produit.libelle }}</h1>
        {{ include('partials/_etat.html.twig', { statut: produit.actif ? 'ACTIF' : 'SUSPENDU' }) }}
    </div>
    <p class="text-sm text-muted-foreground mt-1">{{ produit.site.libellesite ?? 'Pont bascule inconnu' }}</p>
</div>

<twig:Card class="mb-4">
    <twig:Card:Header>
        <twig:Card:Title>Fiche produit</twig:Card:Title>
        <twig:Card:Description>
            Le prix au kilo valorise chaque pesée terminée, sauf si le planteur a un prix spécial.
        </twig:Card:Description>
    </twig:Card:Header>
    <twig:Card:Content class="grid gap-3 sm:grid-cols-2">
        {{ include('partials/_donnee.html.twig', { libelle: 'Libellé', valeur: produit.libelle }) }}
        {{ include('partials/_donnee.html.twig', { libelle: 'Code du poste', valeur: produit.codeproduit }) }}
        {{ include('partials/_donnee.html.twig', {
            libelle: 'Prix au kilo', valeur: produit.prix|number_format(0, ',', ' ') ~ ' F'
        }) }}
        {{ include('partials/_donnee.html.twig', { libelle: 'Pont bascule', valeur: produit.site.libellesite|default(null) }) }}
        {{ include('partials/_donnee.html.twig', {
            libelle: 'Créé le', valeur: produit.createdAt ? produit.createdAt|date('d/m/Y') : null
        }) }}
    </twig:Card:Content>
    {% if modifiable %}
        <twig:Card:Footer>
            <twig:Button as="a" href="{{ path('produit.edit', { id: produit.id }) }}" variant="outline">
                Modifier
            </twig:Button>
        </twig:Card:Footer>
    {% endif %}
</twig:Card>
{% endblock %}
