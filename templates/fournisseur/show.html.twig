{% extends 'base.html.twig' %}

{% block title %}{{ fournisseur.nomComplet }}{% endblock %}

{% block body %}
    <div class="max-w-3xl">
        <div class="mb-6">
            <a href="{{ path('fournisseur.index') }}" class="text-sm text-muted-foreground underline-offset-4 hover:underline">
                ← Retour aux planteurs
            </a>
            <div class="flex flex-wrap items-center gap-3 mt-2">
                <h1 class="text-2xl font-semibold tracking-tight">{{ fournisseur.nomComplet }}</h1>
                {{ include('partials/_etat.html.twig', { statut: fournisseur.statut }) }}
            </div>
            <p class="text-sm text-muted-foreground mt-1">{{ fournisseur.site.libellesite ?? 'Pont bascule inconnu' }}</p>
        </div>

        {% if fournisseur.motifNonPayable %}
            <twig:Alert variant="destructive" class="mb-4">
                <twig:ux:icon name="lucide:triangle-alert" class="size-4" />
                <twig:Alert:Title>Ce planteur ne peut pas être payé</twig:Alert:Title>
                <twig:Alert:Description>
                    {{ fournisseur.motifNonPayable }} — ses pesées s'enregistrent, mais tout
                    versement sera refusé.
                </twig:Alert:Description>
            </twig:Alert>
        {% endif %}

        <twig:Card class="mb-4">
            <twig:Card:Header>
                <twig:Card:Title>Fiche planteur</twig:Card:Title>
            </twig:Card:Header>
            <twig:Card:Content class="grid gap-3 sm:grid-cols-2">
                {{ include('partials/_donnee.html.twig', { libelle: 'Nom', valeur: fournisseur.nom }) }}
                {{ include('partials/_donnee.html.twig', { libelle: 'Prénom', valeur: fournisseur.prenom }) }}
                {{ include('partials/_donnee.html.twig', { libelle: 'Code du poste', valeur: fournisseur.codefournisseur }) }}
                {{ include('partials/_donnee.html.twig', { libelle: 'Téléphone mobile money', valeur: fournisseur.contact1|numero }) }}
                {{ include('partials/_donnee.html.twig', { libelle: 'Autre téléphone', valeur: fournisseur.contact2|numero }) }}
                {{ include('partials/_donnee.html.twig', { libelle: 'Réseau mobile', valeur: fournisseur.reseau }) }}
                {{ include('partials/_donnee.html.twig', {
                    libelle: 'Transport au kilo',
                    valeur: fournisseur.prixtransport ? fournisseur.prixtransport|number_format(0, ',', ' ') ~ ' F' : null
                }) }}
                {{ include('partials/_donnee.html.twig', {
                    libelle: 'Créé le', valeur: fournisseur.createdAt ? fournisseur.createdAt|date('d/m/Y') : null
                }) }}
            </twig:Card:Content>
            {% if modifiable %}
                <twig:Card:Footer>
                    <twig:Button as="a" href="{{ path('fournisseur.edit', { id: fournisseur.id }) }}" variant="outline">
                        Modifier
                    </twig:Button>
                </twig:Card:Footer>
            {% endif %}
        </twig:Card>

        {#
            - La mise en compte. Elle décide de ce que le planteur touche au guichet, elle mérite
              donc sa propre carte — pas une ligne perdue au milieu de son numéro de téléphone.
            - Le solde et le taux disent deux choses différentes : ce qu'on lui garde, et si on
              continue d'en mettre de côté. Un compte peut être plein alors que le prélèvement est
              arrêté depuis des mois.
        #}
        {% set prelevements = fournisseur.prelevements|default([]) %}

        <twig:Card class="mb-4">
            <twig:Card:Header>
                <twig:Card:Title>Compte d'épargne</twig:Card:Title>
                <twig:Card:Description>
                    Une part de chaque pesée est mise de côté au lieu d'être remise au guichet.
                    Elle n'est dans aucune caisse : c'est l'entreprise qui la doit au planteur.
                </twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content class="grid gap-4">
                {{ include('partials/_donnee.html.twig', {
                    libelle: 'Épargne constituée',
                    valeur: (fournisseur.soldeEpargne|default(0))|number_format(0, ',', ' ') ~ ' F'
                }) }}

                {#
                    - UN PRÉLÈVEMENT PAR PRODUIT : les cultures ne se valent pas, et le patron règle
                      chacune à son rythme. Les arrêtés restent affichés, en gris et datés — c'est
                      exactement ce qu'on cherche le jour où le planteur conteste son solde.
                #}
                {% set actifs = prelevements|filter(p => p.actif) %}
                {% set arretes = prelevements|filter(p => not p.actif) %}

                <div>
                    <p class="text-sm font-medium">Prélèvements en cours</p>
                    {% if actifs is empty %}
                        <p class="mt-1 text-sm text-muted-foreground">Aucun : chaque pesée lui est réglée en entier.</p>
                    {% else %}
                        <ul class="mt-2 grid gap-1.5">
                            {% for p in actifs %}
                                <li class="flex flex-wrap items-center justify-between gap-3 rounded-md border border-border px-3 py-2">
                                    <span class="text-sm font-medium">{{ p.produit.libelle ?? '—' }}</span>
                                    <span class="text-sm tabular-nums">
                                        {{ p.taux|number_format(0, ',', ' ') }} F le kilo
                                        {# Le prix du produit à côté du taux : c'est lui qui le borne, et l'écart dit ce qui reste au planteur #}
                                        <span class="text-xs text-muted-foreground">sur {{ (p.produit.prix|default(0))|number_format(0, ',', ' ') }} F</span>
                                    </span>
                                    {% if preleveur %}
                                        <form method="post" action="{{ path('fournisseur.epargne', { id: fournisseur.id }) }}">
                                            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('gestion') }}">
                                            <input type="hidden" name="produit" value="{{ p.produit.id }}">
                                            <input type="hidden" name="taux" value="">
                                            {# Les attributs du module sont 'data-confirmer-detail' et 'data-confirmer-action', pas 'data-detail' : un nom approchant ne lève rien, la boîte s'ouvre simplement sans explication #}
                                            <button class="btn btn-secondary btn-sm"
                                                    data-confirmer="Arrêter le prélèvement sur {{ p.produit.libelle ?? 'ce produit' }} ?"
                                                    data-confirmer-detail="L'épargne déjà constituée reste au planteur. Seules les pesées à venir de ce produit ne seront plus prélevées, et ses autres cultures ne bougent pas."
                                                    data-confirmer-action="Arrêter">
                                                Arrêter
                                            </button>
                                        </form>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>

                {% if arretes is not empty %}
                    <div>
                        <p class="text-sm font-medium">Arrêtés</p>
                        <ul class="mt-2 grid gap-1">
                            {% for p in arretes %}
                                <li class="text-xs text-muted-foreground">
                                    {{ p.produit.libelle ?? '—' }} · {{ p.taux|number_format(0, ',', ' ') }} F le kilo
                                    · arrêté le {{ p.arreteAt|date('d/m/Y') }}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </twig:Card:Content>

            {% if preleveur %}
                <twig:Card:Footer class="flex-col items-stretch gap-3">
                    {#
                        - Ouvrir, ou changer un taux : c'est le même formulaire. Rouvrir sur un produit
                          déjà prélevé arrête l'ancien et en ouvre un nouveau, daté — la fiche garde
                          donc l'histoire plutôt que de prétendre qu'il a toujours épargné au dernier
                          taux connu.
                        - L'arrêt, lui, est le bouton de chaque ligne : il porte le nom du produit, et
                          un champ vide ne dirait pas lequel.
                    #}
                    <form method="post" action="{{ path('fournisseur.epargne', { id: fournisseur.id }) }}" class="flex flex-wrap items-end gap-3">
                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('gestion') }}">
                        <div class="grid gap-1.5">
                            <label for="produit-epargne" class="text-sm font-medium">Produit</label>
                            <select id="produit-epargne" name="produit" required
                                    class="flex h-9 w-64 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50">
                                {% for id, libelle in produits|default({}) %}
                                    <option value="{{ id }}">{{ libelle }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="grid gap-1.5">
                            <label for="taux-epargne" class="text-sm font-medium">Prélèvement par kilo (F CFA)</label>
                            <input id="taux-epargne" name="taux" type="number" min="1" step="1" required
                                   class="flex h-9 w-56 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50">
                        </div>
                        <button class="btn btn-primary">Ouvrir</button>
                    </form>
                    <p class="text-xs text-muted-foreground">
                        Le taux doit rester <strong>inférieur au prix du kilo</strong> du produit, sinon
                        le planteur repartirait les mains vides. Il ne s'applique qu'aux pesées à venir.
                    </p>
                </twig:Card:Footer>
            {% endif %}
        </twig:Card>

        {% if mouvements|default([]) is not empty %}
            <twig:Card class="mb-4">
                <twig:Card:Header>
                    <twig:Card:Title>Mouvements de l'épargne</twig:Card:Title>
                    <twig:Card:Description>
                        Chaque ligne porte le solde avant et après : deux lignes qui se suivent
                        doivent se chaîner.
                    </twig:Card:Description>
                </twig:Card:Header>
                <twig:Card:Content class="p-0">
                    <div class="overflow-x-auto">
                        <twig:Table>
                            <twig:Table:Header>
                                <twig:Table:Row>
                                    <twig:Table:Head>Date</twig:Table:Head>
                                    <twig:Table:Head>Motif</twig:Table:Head>
                                    <twig:Table:Head class="text-right">Montant</twig:Table:Head>
                                    <twig:Table:Head class="text-right">Solde après</twig:Table:Head>
                                </twig:Table:Row>
                            </twig:Table:Header>
                            <twig:Table:Body>
                                {% for mouvement in mouvements %}
                                    <twig:Table:Row>
                                        <twig:Table:Cell>{{ mouvement.createdAt ? mouvement.createdAt|date('d/m/Y') : '—' }}</twig:Table:Cell>
                                        <twig:Table:Cell>{{ mouvement.motif ?? mouvement.typeLibelle ?? '—' }}</twig:Table:Cell>
                                        <twig:Table:Cell class="text-right tabular-nums">+ {{ mouvement.montant|number_format(0, ',', ' ') }} F</twig:Table:Cell>
                                        <twig:Table:Cell class="text-right tabular-nums font-medium">{{ mouvement.soldeApres|number_format(0, ',', ' ') }} F</twig:Table:Cell>
                                    </twig:Table:Row>
                                {% endfor %}
                            </twig:Table:Body>
                        </twig:Table>
                    </div>
                </twig:Card:Content>
            </twig:Card>
        {% endif %}

        {# Ce qu'on vient vraiment vérifier sur la fiche d'un planteur : ce qu'il a livré. #}
        <twig:Card>
            <twig:Card:Header>
                <twig:Card:Title>Dernières pesées</twig:Card:Title>
                <twig:Card:Description>
                    Ce que vaut la récolte, ce qui s'y ajoute ou s'en retire, et ce qui reste à
                    remettre au guichet.
                </twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content class="p-0">
                {#
                    - SIX COLONNES ET NON ONZE. La fiche tient dans 768 px : une colonne par montant
                      — récolte, transport, retenue, payable, versé, reste — obligerait à faire
                      défiler le tableau de côté pour lire une seule ligne. Les montants sont donc
                      groupés là où ils se lisent ensemble, comme dans la file du guichet.

                    - Le découpage suit le raisonnement du domaine, pas la structure de la table :
                      à gauche ce que la pesée VAUT, à droite ce qu'on REMET au planteur. L'écart
                      entre les deux est précisément ce que les lignes secondaires expliquent —
                      sans elles, un planteur qui compare son ticket au guichet ne s'y retrouve pas.
                #}
                <div class="overflow-x-auto">
                    <twig:Table>
                        <twig:Table:Header>
                            <twig:Table:Row>
                                <twig:Table:Head>Ticket</twig:Table:Head>
                                <twig:Table:Head>Produit</twig:Table:Head>
                                <twig:Table:Head class="text-right">Net</twig:Table:Head>
                                <twig:Table:Head class="text-right">Récolte</twig:Table:Head>
                                <twig:Table:Head class="text-right">Au guichet</twig:Table:Head>
                                <twig:Table:Head>Règlement</twig:Table:Head>
                            </twig:Table:Row>
                        </twig:Table:Header>
                        <twig:Table:Body>
                            {% for p in pesees %}
                                {% set transport = p.montanttransport|default(0) %}
                                {% set retenue = p.retenue|default(0) %}
                                {% set paye = p.montantpaye|default(0) %}
                                {% set payable = p.montantpayable|default(0) %}
                                {# 'resteapayer' vient de l'API, qui décompte aussi ce qui est en vol : le recalculer ici donnerait un autre chiffre que le guichet #}
                                {% set reste = p.resteapayer|default(payable - paye) %}
                                <twig:Table:Row>
                                    <twig:Table:Cell>
                                        <a href="{{ path('pesee.voir', { id: p.id }) }}" class="font-medium underline-offset-4 hover:underline">
                                            {{ p.numticket ?? p.codepesee }}
                                        </a>
                                        <div class="text-xs text-muted-foreground whitespace-nowrap">
                                            {{ p.peseeAt2 ? p.peseeAt2|date('d/m/Y') : '—' }}
                                        </div>
                                    </twig:Table:Cell>
                                    <twig:Table:Cell>{{ p.produit.libelle ?? '—' }}</twig:Table:Cell>
                                    <twig:Table:Cell class="text-right tabular-nums whitespace-nowrap">
                                        {{ p.poidsnet ? p.poidsnet|number_format(0, ',', ' ') ~ ' kg' : '—' }}
                                    </twig:Table:Cell>

                                    {# La récolte SEULE, celle qu'imprime le ticket du planteur, et le prix au kilo qui l'a produite #}
                                    <twig:Table:Cell class="text-right tabular-nums whitespace-nowrap">
                                        {{ p.montantdu ? p.montantdu|number_format(0, ',', ' ') ~ ' F' : '—' }}
                                        {% if p.prixunitaire|default(0) > 0 %}
                                            <div class="text-xs text-muted-foreground">
                                                {{ p.prixunitaire|number_format(0, ',', ' ') }} F le kilo
                                            </div>
                                        {% endif %}
                                    </twig:Table:Cell>

                                    {# Ce qu'on lui remet, et les trois écarts qui l'expliquent #}
                                    <twig:Table:Cell class="text-right tabular-nums whitespace-nowrap">
                                        {# Une pesée pas encore valorisée — camion sur le pont, ou produit non tarifé — n'affiche pas « 0 F » : ce zéro-là n'est pas un calcul, c'est une absence #}
                                        {% if not p.montantdu %}
                                            <span class="text-muted-foreground">—</span>
                                        {% else %}
                                        <div class="font-medium">{{ payable|number_format(0, ',', ' ') }} F</div>
                                        {% if transport > 0 %}
                                            <div class="text-xs text-muted-foreground">
                                                + {{ transport|number_format(0, ',', ' ') }} F de transport
                                            </div>
                                        {% endif %}
                                        {% if retenue > 0 %}
                                            <div class="text-xs text-muted-foreground">
                                                − {{ retenue|number_format(0, ',', ' ') }} F mis en compte
                                            </div>
                                        {% endif %}
                                        {% if paye > 0 %}
                                            <div class="text-xs text-muted-foreground">
                                                {{ paye|number_format(0, ',', ' ') }} F versés · reste {{ reste|number_format(0, ',', ' ') }} F
                                            </div>
                                        {% endif %}
                                        {% endif %}
                                    </twig:Table:Cell>

                                    <twig:Table:Cell>{{ include('partials/_etat.html.twig', { statut: p.statutReglement }) }}</twig:Table:Cell>
                                </twig:Table:Row>
                            {% else %}
                                <twig:Table:Row>
                                    <twig:Table:Cell colspan="6" class="text-center text-muted-foreground py-8">
                                        Aucune pesée pour ce planteur
                                    </twig:Table:Cell>
                                </twig:Table:Row>
                            {% endfor %}
                        </twig:Table:Body>
                    </twig:Table>
                </div>
            </twig:Card:Content>
        </twig:Card>
    </div>
{% endblock %}
