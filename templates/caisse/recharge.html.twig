{% extends 'base.html.twig' %}

{% block title %}Recharger le solde{% endblock %}

{% block body %}
    <div class="max-w-xl">
        <div class="mb-6">
            <a href="{{ path('caisse.index') }}" class="text-sm text-muted-foreground underline-offset-4 hover:underline">
                ← Retour à la caisse
            </a>
            <h1 class="text-2xl font-semibold tracking-tight mt-2">Recharger le solde</h1>
            <p class="text-sm text-muted-foreground mt-1">
                Une entrée d'argent venue de l'extérieur, à saisir à la main.
            </p>
        </div>

        {# Les erreurs du formulaire sont rendues par 'form_errors' dans sa carte, plus ici #}

        {#
            - Les deux caisses côte à côte, et non le seul cumul : c'est en les voyant qu'on choisit
              laquelle recharger. Un total de dix millions ne dit pas qu'il ne reste plus un billet.
        #}
        <twig:Card class="mb-4">
            <twig:Card:Content class="pt-6 grid gap-4 sm:grid-cols-2">
                <div>
                    <p class="text-sm text-muted-foreground">Caisse physique — espèces</p>
                    <p class="text-2xl font-semibold tabular-nums mt-1">
                        {{ (entreprise.soldePhysique|default(0))|number_format(0, ',', ' ') }} F
                    </p>
                </div>
                <div>
                    <p class="text-sm text-muted-foreground">Caisse numérique — mobile money</p>
                    <p class="text-2xl font-semibold tabular-nums mt-1">
                        {{ (entreprise.soldeNumerique|default(0))|number_format(0, ',', ' ') }} F
                    </p>
                </div>
            </twig:Card:Content>
        </twig:Card>

        <twig:Card>
            <twig:Card:Header>
                <twig:Card:Title>Nouvelle recharge</twig:Card:Title>
                <twig:Card:Description>
                    Elle est historisée au grand livre comme toutes les autres écritures.
                </twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content>
                {{ form_start(form) }}
                    {{ form_errors(form) }}
                    <div class="grid gap-4">
                        {{ form_row(form.caisse) }}
                        {{ form_row(form.montant) }}
                        {{ form_row(form.motif) }}
                    </div>
                    <div class="mt-6 flex items-center justify-end gap-3 border-t border-border pt-4">
                        <a href="{{ path('caisse.index') }}" class="btn btn-secondary">Annuler</a>
                        <button class="btn btn-primary">Recharger</button>
                    </div>
                {{ form_end(form) }}
            </twig:Card:Content>
        </twig:Card>
    </div>
{% endblock %}
