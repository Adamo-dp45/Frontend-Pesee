{% extends 'base.html.twig' %}

{% block title %}Caisse{% endblock %}

{% block body %}
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Caisse</h1>
            <p class="text-sm text-muted-foreground mt-1">
                L'entreprise détient un solde global et en dote ses ponts bascules.
            </p>
        </div>
        {% if rechargeable %}
            <twig:Button as="a" href="{{ path('caisse.recharge') }}" size="sm">
                <twig:ux:icon name="lucide:plus" class="size-4" />
                Recharger le solde
            </twig:Button>
        {% endif %}
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-6">
        {% if caisse.soldeEntreprise is not null %}
            {{ include('tableau_de_bord/_kpi.html.twig', {
                titre: 'Solde entreprise', valeur: caisse.soldeEntreprise, unite: 'F',
                detail: 'pas encore attribué aux postes', icone: 'lucide:landmark'
            }) }}
        {% endif %}
        {{ include('tableau_de_bord/_kpi.html.twig', {
            titre: 'Dans les caisses', valeur: caisse.soldeSites|default(0), unite: 'F',
            detail: 'réparti sur les ponts bascules', icone: 'lucide:wallet'
        }) }}
        {#
            - Le montant immobilisé explique l'écart entre ce qu'on croit avoir et ce qu'on peut
              engager : ces versements ont quitté la caisse mais ne sont pas encore confirmés.
        #}
        {{ include('tableau_de_bord/_kpi.html.twig', {
            titre: 'Immobilisé', valeur: caisse.montantImmobilise|default(0), unite: 'F',
            detail: 'versements en cours, non confirmés', icone: 'lucide:hourglass'
        }) }}
        {{ include('tableau_de_bord/_kpi.html.twig', {
            titre: 'Demandes en attente', valeur: caisse.demandesEnAttente|default(0), unite: '',
            detail: 'à traiter', icone: 'lucide:inbox'
        }) }}
    </div>

    <twig:Card class="mb-6">
        <twig:Card:Header>
            <twig:Card:Title>Caisse de chaque pont bascule</twig:Card:Title>
        </twig:Card:Header>
        <twig:Card:Content class="p-0">
            <div class="overflow-x-auto">
                <twig:Table>
                    <twig:Table:Header>
                        <twig:Table:Row>
                            <twig:Table:Head>Pont bascule</twig:Table:Head>
                            <twig:Table:Head>Opérateur</twig:Table:Head>
                            <twig:Table:Head class="text-right">Solde</twig:Table:Head>
                            <twig:Table:Head class="text-right">Immobilisé</twig:Table:Head>
                            <twig:Table:Head class="text-right">Disponible</twig:Table:Head>
                            <twig:Table:Head></twig:Table:Head>
                        </twig:Table:Row>
                    </twig:Table:Header>
                    <twig:Table:Body>
                        {% for ligne in caisse.parSite|default([]) %}
                            <twig:Table:Row>
                                <twig:Table:Cell class="font-medium">{{ ligne.site }}</twig:Table:Cell>
                                <twig:Table:Cell>{{ ligne.operateur ?? '—' }}</twig:Table:Cell>
                                <twig:Table:Cell class="text-right tabular-nums">{{ ligne.solde|number_format(0, ',', ' ') }} F</twig:Table:Cell>
                                <twig:Table:Cell class="text-right tabular-nums text-muted-foreground">
                                    {{ ligne.immobilise ? '− ' ~ ligne.immobilise|number_format(0, ',', ' ') ~ ' F' : '—' }}
                                </twig:Table:Cell>
                                <twig:Table:Cell class="text-right tabular-nums font-medium">
                                    {{ (ligne.solde - ligne.immobilise)|number_format(0, ',', ' ') }} F
                                </twig:Table:Cell>
                                <twig:Table:Cell class="text-right">
                                    <a href="{{ path('site.show', { id: ligne.siteId }) }}" class="text-sm underline-offset-4 hover:underline">
                                        {{ dotable ? 'Doter' : 'Ouvrir' }}
                                    </a>
                                </twig:Table:Cell>
                            </twig:Table:Row>
                        {% else %}
                            <twig:Table:Row>
                                <twig:Table:Cell colspan="6" class="text-center text-muted-foreground py-8">
                                    Aucun pont bascule dans votre périmètre
                                </twig:Table:Cell>
                            </twig:Table:Row>
                        {% endfor %}
                    </twig:Table:Body>
                </twig:Table>
            </div>
        </twig:Card:Content>
    </twig:Card>

    <twig:Card>
        <twig:Card:Header>
            <twig:Card:Title>Grand livre</twig:Card:Title>
            <twig:Card:Description>
                Chaque écriture porte le solde avant et après. Une dotation apparaît deux fois :
                un débit chez l'entreprise, un crédit chez le site — l'argent se déplace, il ne se crée pas.
            </twig:Card:Description>
        </twig:Card:Header>
        <twig:Card:Content>
            {#
                - Les filtres vivent DANS la table : ils écrivent dans la même URL que le tri et la
                  pagination, donc un grand livre filtré se partage tel quel.
            #}
            <div {{ react_component('Caisse/TableMouvements', {
                items: items,
                meta: meta,
                queryParams: queryParams,
                sortMeta: sortMeta,
                sites: sites,
            }) }}></div>
        </twig:Card:Content>
    </twig:Card>
{% endblock %}
