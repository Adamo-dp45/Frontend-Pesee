{% extends 'base.html.twig' %}

{% block title %}Nouveau compte{% endblock %}

{% block body %}
    <div class="mb-6">
        <a href="{{ path('utilisateur.index') }}" class="text-sm text-muted-foreground underline-offset-4 hover:underline">
            ← Retour aux utilisateurs
        </a>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight">Nouveau compte</h1>
        <p class="mt-1 text-sm text-muted-foreground">
            {# Un agent ne crée que des opérateurs : la liste des rôles est déjà bornée côté serveur #}
            Le rôle décide de ce que la personne verra et pourra faire.
        </p>
    </div>

    {% include 'utilisateur/_form.html.twig' with { button: 'Créer le compte' } %}
{% endblock %}
