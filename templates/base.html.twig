<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Welcome!{% endblock %} | Webpesee</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <!-- Google -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Manrope:wght@200..800&display=swap" rel="stylesheet">
        <!-- ! -->
        <script>
            document.documentElement.classList.toggle(
                'dark',
                localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
            ) /*
                - Pour éviter le flash au chargement 'FOUC' ce qui applique le thème instantanément et ne doit pas être dans 'turbo:load' car il doit s'exécuter avant le rendu
            */
            if(localStorage.getItem('sidebar-collapsed') === 'true') {
                document.documentElement.classList.add('sidebar-pre-collapsed');
            }
        </script>
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <style>
        .sidebar-pre-collapsed .sidebar {
            width: var(--sidebar-collapsed-w) !important;
            min-width: var(--sidebar-collapsed-w) !important;
        }
    </style>
    <body>
        <div class="shell">
            <div class="sidebar-overlay" id="sidebarOverlay"></div>
            <!-- ═══ SIDEBAR (from Dashboard 1) ═══ -->
            <aside class="sidebar" id="sidebar">
                <div class="sidebar-logo">
                    <div class="sidebar-logo-icon">
                        <svg width="16" height="16"><use href="{{ asset('sprite.svg') }}#logo"></use></svg>
                    </div>
                    <span class="sidebar-logo-text sb-text">Webpesee</span>
                </div>

                <nav class="sidebar-nav">
                    <div class="sidebar-section">
                        {% if not is_granted('ROLE_SUPER_ADMIN') %}
                        <div class="sb-section-title">Principal</div>
                        <a href="{{ path('home') }}" class="nav-link {{ app.current_route starts with 'home' ? 'active' : '' }}" data-nav  title="Tableau de bord">
                            <svg class="nav-icon" aria-hidden="true"><use href="{{ asset('sprite.svg') }}#dashbord"></use></svg>
                            <span class="sb-text">Tableau de bord</span>
                        </a>
                        <a href="{{ path('bilan') }}" class="nav-link {{ app.current_route starts with 'bilan' ? 'active' : '' }}" data-nav  title="Bilan">
                            <svg class="nav-icon" aria-hidden="true"><use href="{{ asset('sprite.svg') }}#dashbord"></use></svg>
                            <span class="sb-text">Bilan</span>
                        </a>
                        {% endif %}
                        {#
                            {% if is_granted('TYPEPIECE_VOIR') or is_granted('MARQUEPIECE_VOIR') %}
                            <button class="nav-link" data-submenu="sub-stock" title="Stock & Approvisionnement">
                                <svg class="nav-icon" aria-hidden="true">
                                    <use href="{{ asset('sprite.svg') }}#stock"></use>
                                </svg>
                                <span class="sb-text">Stock & Approvisionnement</span>
                                <svg class="submenu-arrow" aria-hidden="true" width="14" height="14"><use href="{{ asset('sprite.svg') }}#chevron"></use></svg>
                            </button>
                            <div class="submenu" id="sub-stock">
                                <div class="submenu-inner">
                                    {% if is_granted('TYPEPIECE_VOIR') %}
                                    <a href="{{ path('typepiece.index') }}" class="sub-link {{ app.current_route starts with 'typepiece.' ? 'active' : '' }}" data-subnav>
                                        <span class="sub-dot"></span>Type de pièce
                                    </a>
                                    {% endif %}
                                </div>
                            </div>
                            {% endif %}
                            {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('owner') }}" class="nav-link {{ app.current_route starts with 'owner' ? 'active' : '' }}" data-nav title="Propriétaire">
                                <svg class="nav-icon" aria-hidden="true">
                                    <use href="{{ asset('sprite.svg') }}#owner"></use>
                                </svg>
                                <span class="sb-text">Propriétaire - Tableau de bord</span>
                            </a>
                            {% endif %}
                        #}
                    </div>

                    <div class="sidebar-section">
                        <div class="sb-section-title">Ressources humaines</div>
                        {% if is_granted('ROLE_VOIR') or is_granted('USER_VOIR') or is_granted('ROLE_SUPER_ADMIN') or is_granted('ROLE_ADMIN') %}
                        <button class="nav-link" data-submenu="sub-admin" title="Administration">
                            <svg class="nav-icon" aria-hidden="true">
                                <use href="{{ asset('sprite.svg') }}#admin"></use>
                            </svg>
                            <span class="sb-text">Administration</span>
                            <svg class="submenu-arrow" aria-hidden="true" width="14" height="14"><use href="{{ asset('sprite.svg') }}#chevron"></use></svg>
                        </button>
                        <div class="submenu" id="sub-admin">
                            <div class="submenu-inner">
                                {#
                                {% if is_granted('USER_VOIR') or is_granted('ROLE_SUPER_ADMIN') %}
                                <a href="{{ path('admin.user.index') }}" class="sub-link {{ app.current_route starts with 'admin.user.' ? 'active' : '' }}" data-subnav>
                                    <span class="sub-dot"></span>Utilisateurs
                                </a>
                                {% endif %}
                                {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('admin.entreprise.me') }}" class="sub-link {{ app.current_route starts with 'admin.entreprise.' ? 'active' : '' }}" data-subnav>
                                    <span class="sub-dot"></span>Entreprise
                                </a>
                                {% endif %}
                                #}
                            </div>
                        </div>
                        {% endif %}
                    </div>
                </nav>

                <div class="sidebar-footer">
                    <div class="dropdown-anchor">
                        <button class="sb-footer-user" id="sidebarUserBtn">
                        <div class="user-avatar">
                            {% if app.user.fileUrl is defined and app.user.fileUrl %}
                                <img src="{{ api_url ~ '/media' ~ app.user.fileUrl ~ '?w=80&h=80&fm=jpg&fit=crop' }}" alt="{{ app.user.prenom }} {{ app.user.nom }}" class="w-full h-full object-cover rounded-full" />
                            {% else %}
                                {{ app.user.nom|slice(0,1)|upper }}{{ app.user.prenom|slice(0,1)|upper }}
                            {% endif %}
                        </div>
                        <div class="user-info">
                            <span class="user-name">{{ app.user.nom }}</span>
                            <span class="user-email">{{ app.user.email }}</span>
                        </div>
                            <svg class="user-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
                        </button>
                        <div class="dropdown" id="sidebarUserDrop" style="bottom:calc(100% + .375rem);top:auto;right:0;left:0;min-width:220px;">
                            <div class="dropdown-header">
                                <div class="dropdown-title">{{ app.user.nom }}</div>
                                <div class="dropdown-subtitle">{{ app.user.email }}</div>
                            </div>
                            <div class="dropdown-section">
                                <a href="{{ path('profile.index') }}" class="dropdown-item" data-close-dropdown>
                                    <svg width="14" height="14" aria-hidden="true">
                                        <use href="{{ asset('sprite.svg') }}#profil"></use>
                                    </svg>
                                    Profile
                                </a>
                            </div>
                            <div class="sep"></div>
                            <div class="dropdown-section">
                                <form action="{{ path('app_logout') }}" method="post">
                                    <button class="dropdown-item destructive" data-close-dropdown>
                                        <svg width="14" height="14" aria-hidden="true">
                                            <use href="{{ asset('sprite.svg') }}#logout"></use>
                                        </svg>
                                        Se déconnecté
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </aside>

            <div class="main">
                <header class="topbar">
                    <div class="topbar-left">
                        <button class="icon-btn" id="sidebarToggle">
                            <svg width="18" height="18" aria-hidden="true">
                                <use href="{{ asset('sprite.svg') }}#panel-left"></use>
                            </svg>
                        </button>
                    </div>
                    <div class="topbar-right">
                        <button class="theme-btn" id="themeBtn">
                            <svg id="sun-i" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="4"/>
                                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
                            </svg>
                            <svg id="moon-i" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
                            </svg>
                            <span id="theme-lbl" class="theme-lbl-text">Dark</span>
                        </button>
                        <div class="topbar-divider"></div>

                        <div class="dropdown-anchor">
                            <button class="topbar-avatar" id="profileBtn">
                                {% if app.user.fileUrl is defined and app.user.fileUrl %}
                                    <img src="{{ api_url ~ '/media' ~ app.user.fileUrl ~ '?w=80&h=80&fm=jpg&fit=crop' }}" alt="{{ app.user.prenom }} {{ app.user.nom }}" class="w-full h-full object-cover rounded-full" />
                                {% else %}
                                    {{ app.user.nom|slice(0,1)|upper }}{{ app.user.prenom|slice(0,1)|upper }}
                                {% endif %}
                            </button>
                            <div class="dropdown" id="profileDrop" style="min-width:220px;right:0;top:calc(100% + .375rem);">
                                <div class="dropdown-header">
                                    <div style="display:flex;align-items:center;gap:.625rem;">
                                        <div style="width:2.25rem;height:2.25rem;border-radius:9999px;background:var(--primary);display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;color:var(--primary-fg);flex-shrink:0;">
                                            {% if app.user.fileUrl is defined and app.user.fileUrl %}
                                                <img src="{{ api_url ~ '/media' ~ app.user.fileUrl ~ '?w=80&h=80&fm=jpg&fit=crop' }}" alt="{{ app.user.prenom }} {{ app.user.nom }}" class="w-full h-full object-cover rounded-full" />
                                            {% else %}
                                                {{ app.user.nom|slice(0,1)|upper }}{{ app.user.prenom|slice(0,1)|upper }}
                                            {% endif %}
                                        </div>
                                        <div>
                                            <div class="dropdown-title">{{ app.user.nom }} {{ app.user.prenom }}</div>
                                            <div class="dropdown-subtitle">{{ app.user.email }}</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="dropdown-section">
                                    <div class="dropdown-label">Compte</div>
                                    <a href="{{ path('profile.index') }}" class="dropdown-item" data-close-dropdown>
                                        <svg width="14" height="14" aria-hidden="true">
                                            <use href="{{ asset('sprite.svg') }}#profil"></use>
                                        </svg>
                                        Profil
                                    </a>
                                </div>
                                <div class="sep"></div>
                                <div class="dropdown-section">
                                    <form action="{{ path('app_logout') }}" method="post">
                                        <button class="dropdown-item destructive" data-close-dropdown>
                                            <svg width="14" height="14" aria-hidden="true">
                                                <use href="{{ asset('sprite.svg') }}#logout"></use>
                                            </svg>
                                            Se déconnecté
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </header>

                <div class="content">
                    <div class="content-inner">
                        {% include 'partials/flash.html.twig' %}
                        {% block body %}{% endblock %}
                    </div>
                </div>
            </div>
        </div>
    </body>
</html>